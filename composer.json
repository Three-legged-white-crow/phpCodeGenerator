{
    "name": "three-legged-white-crow/php-code-generator",
    "description": "Generate PHP class / namespace / file-header code as strings",
    "type": "library",
    "keywords": [
        "auto",
        "generator",
        "scaffold",
        "code-generator",
        "php"
    ],
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "shuimengzhi",
            "email": "shuimengzhi@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5.22"
    },
    "autoload": {
        "psr-4": {
            "src\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "test\\": "test"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
